# CONFIGURACIÓN DE PRODUCCIÓN - Mesa de Partes PNP
# ⚠️ NO SUBIR ESTE ARCHIVO A GIT ⚠️

# ========================================
# BASE DE DATOS
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mesa_partes_db
DB_USERNAME=root
DB_PASSWORD=CAMBIAR_ESTE_PASSWORD_EN_PRODUCCION

# ========================================
# SEGURIDAD JWT
# ========================================
# IMPORTANTE: Generar un nuevo secret para producción
# Usar: openssl rand -base64 32
# O PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
JWT_SECRET=Q2xhdmVTZWNyZXRvUGFyYU1lc2FEZVBhcnRlc1BOUFF1ZUVzTXV5RGlmaWNpbERlQWRpdmluYXJZRXNhRXNMYUlkZWE=

# ========================================
# CONFIGURACIÓN DE EMAIL (SMTP)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password-de-16-caracteres

# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ========================================
# SSL/HTTPS (Producción)
# ========================================
SSL_ENABLED=false
SSL_KEYSTORE_PASSWORD=tu-password-keystore

# ========================================
# CONFIGURACIÓN DE BACKUP
# ========================================
BACKUP_DIR=C:/backups/mesa_partes
BACKUP_RETENTION_DAYS=30

# ========================================
# INSTRUCCIONES
# ========================================
# 1. Copiar este archivo como .env
# 2. Cambiar TODOS los valores por los reales de producción
# 3. Generar nuevo JWT_SECRET
# 4. Configurar credenciales de Gmail App Password
# 5. Cambiar DB_PASSWORD
# 6. NO subir .env a Git (ya está en .gitignore)
